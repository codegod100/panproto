{
  "lexicon": 1,
  "id": "dev.panproto.node.listRefs",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["repo"],
        "properties": {
          "repo": { "type": "string", "maxLength": 256 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["refs"],
          "properties": {
            "refs": {
              "type": "array",
              "items": { "type": "ref", "ref": "#refEntry" }
            }
          }
        }
      }
    },
    "refEntry": {
      "type": "object",
      "required": ["name", "hash"],
      "properties": {
        "name": { "type": "string", "maxLength": 256 },
        "hash": { "type": "string", "maxLength": 64 }
      }
    }
  }
}
