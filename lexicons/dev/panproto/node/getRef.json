{
  "lexicon": 1,
  "id": "dev.panproto.node.getRef",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["repo", "ref"],
        "properties": {
          "repo": { "type": "string", "maxLength": 256 },
          "ref": { "type": "string", "maxLength": 256 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["hash"],
          "properties": {
            "hash": { "type": "string", "maxLength": 64 }
          }
        }
      }
    }
  }
}
