{
  "lexicon": 1,
  "id": "dev.panproto.registry.getPackage",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["did", "name"],
        "properties": {
          "did": { "type": "string", "format": "did" },
          "name": { "type": "string", "maxLength": 128 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "name", "protocol", "createdAt"],
          "properties": {
            "uri": { "type": "string", "format": "at-uri" },
            "name": { "type": "string", "maxLength": 128 },
            "description": { "type": "string", "maxLength": 2560 },
            "protocol": { "type": "string", "maxLength": 128 },
            "license": { "type": "string", "maxLength": 64 },
            "keywords": {
              "type": "array",
              "items": { "type": "string", "maxLength": 64 }
            },
            "homepage": { "type": "string", "format": "uri" },
            "latestVersion": { "type": "string", "maxLength": 64 },
            "versionCount": { "type": "integer" },
            "dependencyCount": { "type": "integer" },
            "ownerDid": { "type": "string", "format": "did" },
            "createdAt": { "type": "string", "format": "datetime" }
          }
        }
      }
    }
  }
}
