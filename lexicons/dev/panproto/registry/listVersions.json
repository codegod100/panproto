{
  "lexicon": 1,
  "id": "dev.panproto.registry.listVersions",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["package"],
        "properties": {
          "package": { "type": "string", "format": "at-uri" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["versions"],
          "properties": {
            "cursor": { "type": "string" },
            "versions": {
              "type": "array",
              "items": { "type": "ref", "ref": "#versionView" }
            }
          }
        }
      }
    },
    "versionView": {
      "type": "object",
      "required": ["uri", "version", "createdAt"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "version": { "type": "string", "maxLength": 64 },
        "schemaUri": { "type": "string", "format": "at-uri" },
        "migrationUri": { "type": "string", "format": "at-uri" },
        "lensUri": { "type": "string", "format": "at-uri" },
        "createdAt": { "type": "string", "format": "datetime" }
      }
    }
  }
}
