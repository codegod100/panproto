{
  "lexicon": 1,
  "id": "dev.panproto.registry.searchPackages",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "maxLength": 256 },
          "protocol": { "type": "string", "maxLength": 128 },
          "category": { "type": "string", "maxLength": 64 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["packages"],
          "properties": {
            "cursor": { "type": "string" },
            "packages": {
              "type": "array",
              "items": { "type": "ref", "ref": "#packageView" }
            }
          }
        }
      }
    },
    "packageView": {
      "type": "object",
      "required": ["uri", "name", "protocol"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "name": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 2560 },
        "protocol": { "type": "string", "maxLength": 128 },
        "latestVersion": { "type": "string", "maxLength": 64 },
        "ownerDid": { "type": "string", "format": "did" }
      }
    }
  }
}
