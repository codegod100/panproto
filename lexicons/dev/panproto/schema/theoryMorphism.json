{
  "lexicon": 1,
  "id": "dev.panproto.schema.theoryMorphism",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["name", "sourceTheory", "targetTheory", "objectHash", "createdAt"],
        "properties": {
          "name": { "type": "string", "maxLength": 256 },
          "sourceTheory": { "type": "string", "format": "at-uri" },
          "targetTheory": { "type": "string", "format": "at-uri" },
          "objectHash": { "type": "string", "maxLength": 64 },
          "blob": { "type": "blob", "accept": ["application/x-msgpack"], "maxSize": 1048576 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
