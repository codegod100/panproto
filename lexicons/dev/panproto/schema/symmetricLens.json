{
  "lexicon": 1,
  "id": "dev.panproto.schema.symmetricLens",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["leftLens", "rightLens", "middleSchema", "objectHash", "createdAt"],
        "properties": {
          "leftLens": { "type": "string", "format": "at-uri" },
          "rightLens": { "type": "string", "format": "at-uri" },
          "middleSchema": { "type": "string", "format": "at-uri" },
          "objectHash": { "type": "string", "maxLength": 64 },
          "coherenceVerified": { "type": "boolean" },
          "blob": { "type": "blob", "accept": ["application/x-msgpack"], "maxSize": 1048576 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
